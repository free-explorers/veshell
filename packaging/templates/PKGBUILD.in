# Maintainer: @MAINTAINER@
# Arch/Manjaro source package for Veshell.
#
# Generated from packaging/templates/PKGBUILD.in by
# packaging/scripts/render-recipes.py. Do not edit by hand.
#
# Builds the Dart shell and the Rust compositor from source, entirely offline.
# All external Flutter inputs are pinned and checksummed: the official Flutter
# SDK bundle, the matching engine artifacts, and the meta-flutter embedder
# engine. `build-veshell.sh` is a copy of packaging/scripts/build-veshell.sh.
#
# The two generated inputs (Cargo vendor tree, Dart pub cache) are published
# alongside each release. Regenerate and refresh their checksums with
# packaging/scripts/generate-inputs.sh, then re-render this recipe.

pkgname=@NAME@
pkgver=@ARCH_PKGVER@
pkgrel=@ARCH_PKGREL@
pkgdesc="An innovative Not-Desktop environment for Linux built with Flutter and Rust"
arch=('x86_64')
url="https://github.com/free-explorers/veshell"
license=('GPL-3.0-or-later')
depends=(
  'fontconfig' 'ttf-roboto' 'noto-fonts' 'noto-fonts-cjk'
  'libglvnd' 'mesa' 'libgbm'
  'libinput' 'seatd' 'systemd-libs' 'libxkbcommon'
  'libdisplay-info'
  'pipewire' 'libpulse'
  'gst-plugins-base' 'gst-plugins-base-libs' 'gst-plugins-good'
  'dbus' 'upower' 'polkit'
  'xorg-xwayland' 'xdg-desktop-portal' 'xdg-utils'
)
makedepends=(
  'rust' 'clang' 'cmake' 'ninja' 'pkgconf' 'git'
  'unzip' 'zstd' 'xz'
  'gtk3' 'libpulse'
  'libinput' 'seatd' 'libgbm' 'mesa' 'openssl'
  'pipewire' 'gstreamer' 'gst-plugins-base-libs'
  'libxkbcommon' 'libdisplay-info' 'wayland' 'systemd-libs'
  'vulkan-icd-loader'
)
optdepends=(
  'networkmanager: network control panel'
  'bluez: Bluetooth control panel'
  'rtkit: real-time audio scheduling'
  'xdg-desktop-portal-gtk: GTK portal fallback backend'
)
provides=('wayland-compositor')
conflicts=('veshell-git')
# makepkg's global `lto` option adds -flto to CFLAGS. The libspa-sys build
# script compiles a C shim into a static archive; LTO objects there are not
# resolved by rustc's final (non-LTO) link. Disable LTO for this package.
options=('!lto')

# --- pinned inputs ----------------------------------------------------------
_veshell_commit=@COMMIT@
_flutter_version=@FLUTTER_VERSION@
_flutter_engine_revision=@FLUTTER_ENGINE_REVISION@
_input_mirror="${VESHELL_INPUT_MIRROR:-@INPUT_MIRROR@}"

source=(
  "veshell::git+https://github.com/free-explorers/veshell.git#commit=$_veshell_commit"
  "build-veshell.sh"
  "flutter_linux_${_flutter_version}-stable.tar.xz::@FLUTTER_SDK_URL@"
  "flutter_patched_sdk.zip::@FLUTTER_PATCHED_SDK_URL@"
  "flutter_patched_sdk_product.zip::@FLUTTER_PATCHED_SDK_PRODUCT_URL@"
  "linux-x64_artifacts.zip::@FLUTTER_LINUX_X64_ARTIFACTS_URL@"
  "linux-x64-debug_flutter-gtk.zip::@FLUTTER_LINUX_X64_DEBUG_GTK_URL@"
  "linux-x64-profile_flutter-gtk.zip::@FLUTTER_LINUX_X64_PROFILE_GTK_URL@"
  "linux-x64-release_flutter-gtk.zip::@FLUTTER_LINUX_X64_RELEASE_GTK_URL@"
  "linux-engine-sdk-release-x86_64-${_flutter_engine_revision}.tar.gz::@ENGINE_URL@"
  "veshell-cargo-vendor-@RELEASE_ID@.tar.zst::$_input_mirror/veshell-cargo-vendor-@RELEASE_ID@.tar.zst"
  "veshell-pubcache-@RELEASE_ID@.tar.zst::$_input_mirror/veshell-pubcache-@RELEASE_ID@.tar.zst"
)
sha256sums=(
  'SKIP'  # pinned git commit
  '@BUILD_SCRIPT_SHA256@'  # build-veshell.sh
  '@FLUTTER_SDK_SHA256@'  # Flutter SDK
  '@FLUTTER_PATCHED_SDK_SHA256@'  # patched_sdk
  '@FLUTTER_PATCHED_SDK_PRODUCT_SHA256@'  # patched_sdk_product
  '@FLUTTER_LINUX_X64_ARTIFACTS_SHA256@'  # linux-x64 artifacts
  '@FLUTTER_LINUX_X64_DEBUG_GTK_SHA256@'  # linux-x64 debug gtk
  '@FLUTTER_LINUX_X64_PROFILE_GTK_SHA256@'  # linux-x64 profile gtk
  '@FLUTTER_LINUX_X64_RELEASE_GTK_SHA256@'  # linux-x64 release gtk
  '@ENGINE_SHA256@'  # embedder engine
  '@CARGO_VENDOR_SHA256@'  # cargo vendor
  '@PUBCACHE_SHA256@'  # pub cache
)

# The helper extracts every archive itself (into deterministic locations);
# let makepkg keep the raw sources untouched.
noextract=(
  "flutter_linux_${_flutter_version}-stable.tar.xz"
  "flutter_patched_sdk.zip"
  "flutter_patched_sdk_product.zip"
  "linux-x64_artifacts.zip"
  "linux-x64-debug_flutter-gtk.zip"
  "linux-x64-profile_flutter-gtk.zip"
  "linux-x64-release_flutter-gtk.zip"
  "linux-engine-sdk-release-x86_64-${_flutter_engine_revision}.tar.gz"
  "veshell-cargo-vendor-@RELEASE_ID@.tar.zst"
  "veshell-pubcache-@RELEASE_ID@.tar.zst"
)

prepare() {
  cd veshell
  mkdir -p "$srcdir/flutter-sdk" "$srcdir/cargo-vendor" "$srcdir/pubcache"
  tar -xJf "$srcdir/flutter_linux_${_flutter_version}-stable.tar.xz" \
    -C "$srcdir/flutter-sdk" --strip-components=1
  tar -xf "$srcdir/veshell-cargo-vendor-@RELEASE_ID@.tar.zst" -C "$srcdir/cargo-vendor"
  tar -xf "$srcdir/veshell-pubcache-@RELEASE_ID@.tar.zst" -C "$srcdir/pubcache"
}

build() {
  cd veshell
  VESHELL_SRC="$PWD" \
  FLUTTER_SDK_DIR="$srcdir/flutter-sdk" \
  FLUTTER_ARTIFACT_DIR="$srcdir" \
  ENGINE_TARBALL="$srcdir/linux-engine-sdk-release-x86_64-${_flutter_engine_revision}.tar.gz" \
  CARGO_VENDOR_DIR="$srcdir/cargo-vendor" \
  PUB_CACHE_DIR="$srcdir/pubcache" \
  PREFIX=/usr \
  POLKIT_HELPER_PATH=@POLKIT_HELPER@ \
  JOBS="$(nproc)" \
  bash "$srcdir/build-veshell.sh" build
}

package() {
  cd veshell
  VESHELL_SRC="$PWD" \
  PREFIX=/usr \
  DESTDIR="$pkgdir" \
  bash "$srcdir/build-veshell.sh" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
