{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/free-explorers/veshell/packaging/release.schema.json",
  "title": "Veshell release manifest",
  "description": "Single source of truth consumed by packaging/scripts/render-recipes.py and the release pipeline. URL fields pin the exact upstream artifacts; sha256 fields pin their content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "version", "channel", "date", "commit", "maintainer", "polkit_helper", "mirrors", "flutter", "inputs"],
  "properties": {
    "schema": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": {
      "type": "string",
      "description": "Base semantic version, without a pre-release suffix.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "prerelease": {
      "type": ["string", "null"],
      "description": "Pre-release identifier such as beta.1 or rc.2, or null for a final release.",
      "pattern": "^[A-Za-z0-9.]+$"
    },
    "channel": { "type": "string", "enum": ["beta", "stable"] },
    "date": {
      "type": "string",
      "description": "Release timestamp, ISO 8601 with timezone.",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "maintainer": { "type": "string", "minLength": 1 },
    "polkit_helper": { "type": "string", "pattern": "^/" },
    "mirrors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "inputs"],
      "properties": {
        "source": { "type": "string", "format": "uri", "pattern": "^https://" },
        "inputs": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "flutter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "channel", "engine_revision", "sdk", "artifacts", "engine"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "channel": { "type": "string", "enum": ["stable", "beta", "dev"] },
        "engine_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sdk": { "$ref": "#/definitions/artifact" },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["patched_sdk", "patched_sdk_product", "linux_x64_artifacts", "linux_x64_debug_gtk", "linux_x64_profile_gtk", "linux_x64_release_gtk"],
          "properties": {
            "patched_sdk": { "$ref": "#/definitions/artifact" },
            "patched_sdk_product": { "$ref": "#/definitions/artifact" },
            "linux_x64_artifacts": { "$ref": "#/definitions/artifact" },
            "linux_x64_debug_gtk": { "$ref": "#/definitions/artifact" },
            "linux_x64_profile_gtk": { "$ref": "#/definitions/artifact" },
            "linux_x64_release_gtk": { "$ref": "#/definitions/artifact" }
          }
        },
        "engine": { "$ref": "#/definitions/artifact" }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cargo_vendor", "pubcache"],
      "properties": {
        "cargo_vendor": { "$ref": "#/definitions/checksum" },
        "pubcache": { "$ref": "#/definitions/checksum" }
      }
    }
  },
  "definitions": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
