{
    "keyboard": {
        "layout": "us(altgr-intl)",
        "swapAltAndWin": false,
        "hotkeys": {
            "system": {
                "increaseVolume": "volumeUp",
                "decreaseVolume": "volumeDown",
                "muteVolume": "volumeMute"
            },
            "media": {
                "playPause": "mediaPlayPause",
                "next": "mediaTrackNext",
                "previous": "mediaTrackPrevious",
                "stop": "mediaStop"
            },
            "screen": {
                "focusWorkspaceAbove": "super+w",
                "focusWorkspaceBelow": "super+s",
                "reorderWorkspaceAbove": "super+shift+w",
                "reorderWorkspaceBelow": "super+shift+s"
            },
            "workspace": {
                "focusLeftTileable": "super+a",
                "focusRightTileable": "super+d",
                "reorderLeftTileable": "super+shift+a",
                "reorderRightTileable": "super+shift+d",
                "closeTileable": "super+q"
            }
        }
    },
    "mouseAndTouchpad": {
        "naturalScrolling": true
    },
    "theme": {
        "color": "0xFF006888",
        "gtkTheme": "Adwaita-dark",
        "iconTheme": "Adwaita"
    },
    "idle": {
        "dimTimeoutSeconds": 60,
        "blankTimeoutSeconds": 240,
        "fadeSeconds": 3.0,
        "automaticPowerAction": "suspendThenHibernate",
        "automaticPowerTimeoutSeconds": 600
    },
    "$schema": "../schemas/settings.schema.json"
}