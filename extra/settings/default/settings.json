{
    "system": {
        "language": null
    },
    "environment": {
        "variables": {}
    },
    "keyboard": {
        "layout": "us(altgr-intl)",
        "swapAltAndWin": false,
        "capsLock": "default",
        "repeat": true,
        "repeatDelayMs": 500,
        "repeatRate": 30,
        "hotkeys": {
            "system": {
                "increaseVolume": ["volumeUp"],
                "decreaseVolume": ["volumeDown"],
                "muteVolume": ["volumeMute"],
                "increaseBrightness": ["brightnessUp"],
                "decreaseBrightness": ["brightnessDown"],
                "toggleKeyboardLayout": ["super+space"]
            },
            "media": {
                "playPause": ["mediaPlayPause"],
                "next": ["mediaTrackNext"],
                "previous": ["mediaTrackPrevious"],
                "stop": ["mediaStop"]
            },
            "navigation": {
                "up": ["super+w", "super+arrowUp"],
                "down": ["super+s", "super+arrowDown"],
                "left": ["super+a", "super+arrowLeft"],
                "right": ["super+d", "super+arrowRight"],
                "moveUp": ["super+shift+w", "super+shift+arrowUp"],
                "moveDown": ["super+shift+s", "super+shift+arrowDown"],
                "moveLeft": ["super+shift+a", "super+shift+arrowLeft"],
                "moveRight": ["super+shift+d", "super+shift+arrowRight"],
                "activate": ["enter", "numpadEnter"],
                "close": ["super+q"]
            }
        }
    },
    "mouseAndTouchpad": {
        "mouseNaturalScrolling": false,
        "touchpadNaturalScrolling": true,
        "wheelScrollFactor": 1.0
    },
    "theme": {
        "color": "0xFF006888"
    },
    "idle": {
        "dimTimeoutSeconds": 60,
        "blankTimeoutSeconds": 240,
        "fadeSeconds": 3.0,
        "automaticPowerAction": "suspendThenHibernate",
        "automaticPowerTimeoutSeconds": 600
    },
    "notifications": {
        "batteryLowThreshold": 20,
        "batteryCriticalThreshold": 10
    },
    "$schema": "../schemas/settings.schema.json"
}
