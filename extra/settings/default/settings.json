{
    "system": {
        "language": null
    },
    "environment": {
        "variables": {}
    },
    "keyboard": {
        "layout": "us(altgr-intl)",
        "swapAltAndWin": false,
        "capsLock": "default",
        "composeKey": "none",
        "options": [],
        "repeat": true,
        "repeatDelayMs": 500,
        "repeatRate": 30,
        "hotkeys": {
            "system": {
                "increaseVolume": ["volumeUp"],
                "decreaseVolume": ["volumeDown"],
                "muteVolume": ["volumeMute"],
                "increaseBrightness": ["brightnessUp"],
                "decreaseBrightness": ["brightnessDown"],
                "toggleKeyboardLayout": ["super+space"],
                "lockSession": ["super+l"]
            },
            "media": {
                "playPause": ["mediaPlayPause"],
                "next": ["mediaTrackNext"],
                "previous": ["mediaTrackPrevious"],
                "stop": ["mediaStop"]
            },
            "navigation": {
                "up": ["super+w", "super+arrowUp"],
                "down": ["super+s", "super+arrowDown"],
                "left": ["super+a", "super+arrowLeft"],
                "right": ["super+d", "super+arrowRight"],
                "moveUp": ["super+shift+w", "super+shift+arrowUp"],
                "moveDown": ["super+shift+s", "super+shift+arrowDown"],
                "moveLeft": ["super+shift+a", "super+shift+arrowLeft"],
                "moveRight": ["super+shift+d", "super+shift+arrowRight"],
                "activate": ["enter", "numpadEnter"],
                "close": ["super+q"]
            }
        }
    },
    "mouseAndTouchpad": {
        "mouseNaturalScrolling": false,
        "touchpadNaturalScrolling": true,
        "wheelScrollFactor": 1.0,
        "mouseAccelerationProfile": "default",
        "touchpadAccelerationProfile": "default"
    },
    "gamepad": {
        "repeatDelayMs": 400,
        "repeatIntervalMs": 120,
        "bindings": {
            "navigation": {
                "up": ["dpadUp", "leftStickUp"],
                "down": ["dpadDown", "leftStickDown"],
                "left": ["dpadLeft", "leftStickLeft"],
                "right": ["dpadRight", "leftStickRight"],
                "moveUp": ["leftShoulder+dpadUp", "leftShoulder+leftStickUp"],
                "moveDown": ["leftShoulder+dpadDown", "leftShoulder+leftStickDown"],
                "moveLeft": ["leftShoulder+dpadLeft", "leftShoulder+leftStickLeft"],
                "moveRight": ["leftShoulder+dpadRight", "leftShoulder+leftStickRight"],
                "activate": ["south"],
                "dismiss": ["east"],
                "close": ["select+north"],
                "cycleBackward": ["leftShoulder"],
                "cycleForward": ["rightShoulder"]
            },
            "overview": {
                "toggle": ["start", "guide"]
            }
        }
    },
    "files": {
        "showHidden": false,
        "sortBy": "name",
        "sortDescending": false,
        "foldersFirst": true,
        "showDetails": false
    },
    "theme": {
        "color": "0xFF006888",
        "cursorTheme": "",
        "cursorSize": 24,
        "focusIndicator": "grayscale",
        "workspaceIcon": "hybrid",
        "animationSpeed": 1,
        "statusBar": "none",
        "statusBarContent": {
            "showClock": true,
            "clockFormat": "locale",
            "showKeyboardLayout": true,
            "showWifi": true,
            "showVolume": true,
            "showBattery": true,
            "showBatteryPercentage": true
        }
    },
    "idle": {
        "dimTimeoutSeconds": 60,
        "blankTimeoutSeconds": 240,
        "fadeSeconds": 3.0,
        "automaticPowerAction": "suspendThenHibernate",
        "automaticPowerTimeoutSeconds": 600,
        "powerButtonAction": "suspendThenHibernate"
    },
    "notifications": {
        "batteryLowThreshold": 20,
        "batteryCriticalThreshold": 10
    },
    "$schema": "../schemas/settings.schema.json"
}
