{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Veshell Settings",
    "description": "System settings",
    "type": "object",
    "$defs": {
        "hotkeyList": {
            "description": "One or more key chords bound to the same action.",
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "properties": {
        "$schema": {
            "type": "string"
        },
        "environment": {
            "type": "object",
            "properties": {
                "variables": {
                    "description": "Environment variables applied to applications launched by Veshell, as a NAME to value map.",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "keyboard": {
            "type": "object",
            "properties": {
                "layout": {
                    "type": "string"
                },
                "swapAltAndWin": {
                    "type": "boolean"
                },
                "capsLock": {
                    "type": "string",
                    "enum": [
                        "default",
                        "control",
                        "escape",
                        "swapescape",
                        "disabled"
                    ]
                },
                "repeat": {
                    "type": "boolean"
                },
                "repeatDelayMs": {
                    "type": "integer",
                    "minimum": 0
                },
                "repeatRate": {
                    "type": "integer",
                    "minimum": 0
                },
                "hotkeys": {
                    "type": "object",
                    "properties": {
                        "system": {
                            "type": "object",
                            "properties": {
                                "increaseVolume": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "decreaseVolume": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "muteVolume": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "increaseBrightness": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "decreaseBrightness": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "toggleKeyboardLayout": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "lockSession": {
                                    "$ref": "#/$defs/hotkeyList"
                                }
                            }
                        },
                        "media": {
                            "type": "object",
                            "properties": {
                                "playPause": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "next": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "previous": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "stop": {
                                    "$ref": "#/$defs/hotkeyList"
                                }
                            }
                        },
                        "navigation": {
                            "type": "object",
                            "properties": {
                                "up": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "down": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "left": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "right": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "moveUp": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "moveDown": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "moveLeft": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "moveRight": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "activate": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "close": {
                                    "$ref": "#/$defs/hotkeyList"
                                }
                            }
                        }
                    }
                }
            },
            "additionalProperties": false
        },
        "mouseAndTouchpad": {
            "type": "object",
            "properties": {
                "mouseNaturalScrolling": {
                    "type": "boolean"
                },
                "touchpadNaturalScrolling": {
                    "type": "boolean"
                },
                "wheelScrollFactor": {
                    "type": "number",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "theme": {
            "type": "object",
            "properties": {
                "color": {
                    "type": "string"
                },
                "gtkTheme": {
                    "type": "string"
                },
                "iconTheme": {
                    "type": "string"
                },
                "focusIndicator": {
                    "type": "string",
                    "enum": [
                        "border",
                        "grayscale",
                        "none"
                    ]
                }
            },
            "additionalProperties": false
        },
        "idle": {
            "type": "object",
            "properties": {
                "dimTimeoutSeconds": {
                    "type": "integer",
                    "minimum": 0
                },
                "blankTimeoutSeconds": {
                    "type": "integer",
                    "minimum": 0
                },
                "fadeSeconds": {
                    "type": "number",
                    "minimum": 0
                },
                "automaticPowerAction": {
                    "type": "string",
                    "enum": [
                        "disabled",
                        "suspend",
                        "hibernate",
                        "suspendThenHibernate"
                    ]
                },
                "automaticPowerTimeoutSeconds": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "notifications": {
            "type": "object",
            "properties": {
                "batteryLowThreshold": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                },
                "batteryCriticalThreshold": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                }
            },
            "additionalProperties": false
        }
    }
}
