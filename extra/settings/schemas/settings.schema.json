{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Veshell Settings",
    "description": "System settings",
    "type": "object",
    "$defs": {
        "hotkeyList": {
            "description": "One or more key chords bound to the same action.",
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "gamepadChordList": {
            "description": "One or more gamepad chords bound to the same action: buttons held together, joined by '+' (\"leftShoulder+dpadLeft\").",
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^(south|east|north|west|leftShoulder|rightShoulder|leftTrigger|rightTrigger|select|start|guide|leftThumb|rightThumb|dpadUp|dpadDown|dpadLeft|dpadRight|leftStickUp|leftStickDown|leftStickLeft|leftStickRight|rightStickUp|rightStickDown|rightStickLeft|rightStickRight)(\\+(south|east|north|west|leftShoulder|rightShoulder|leftTrigger|rightTrigger|select|start|guide|leftThumb|rightThumb|dpadUp|dpadDown|dpadLeft|dpadRight|leftStickUp|leftStickDown|leftStickLeft|leftStickRight|rightStickUp|rightStickDown|rightStickLeft|rightStickRight))*$"
            }
        }
    },
    "properties": {
        "$schema": {
            "type": "string"
        },
        "environment": {
            "type": "object",
            "properties": {
                "variables": {
                    "description": "Environment variables applied to applications launched by Veshell, as a NAME to value map.",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "keyboard": {
            "type": "object",
            "properties": {
                "layout": {
                    "type": "string"
                },
                "swapAltAndWin": {
                    "type": "boolean"
                },
                "capsLock": {
                    "type": "string",
                    "enum": [
                        "default",
                        "control",
                        "escape",
                        "swapescape",
                        "disabled"
                    ]
                },
                "composeKey": {
                    "type": "string",
                    "enum": [
                        "none",
                        "ralt",
                        "lwin",
                        "rwin",
                        "menu",
                        "lctrl",
                        "rctrl",
                        "caps",
                        "102",
                        "prsc",
                        "sclk",
                        "paus",
                        "ins"
                    ]
                },
                "options": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.+-]+:[A-Za-z0-9_.+-]+$"
                    },
                    "uniqueItems": true
                },
                "repeat": {
                    "type": "boolean"
                },
                "repeatDelayMs": {
                    "type": "integer",
                    "minimum": 0
                },
                "repeatRate": {
                    "type": "integer",
                    "minimum": 0
                },
                "showKeyPresses": {
                    "description": "Show the keys pressed on screen, for screencasts and presentations.",
                    "type": "boolean"
                },
                "keyPressPosition": {
                    "description": "Where the keys pressed are shown on each monitor.",
                    "type": "string",
                    "enum": [
                        "bottomRight",
                        "bottomCenter",
                        "bottomLeft",
                        "topRight",
                        "topCenter",
                        "topLeft"
                    ]
                },
                "hotkeys": {
                    "type": "object",
                    "properties": {
                        "system": {
                            "type": "object",
                            "properties": {
                                "increaseVolume": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "decreaseVolume": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "muteVolume": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "increaseBrightness": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "decreaseBrightness": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "toggleKeyboardLayout": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "lockSession": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "toggleKeyPresses": {
                                    "$ref": "#/$defs/hotkeyList"
                                }
                            }
                        },
                        "media": {
                            "type": "object",
                            "properties": {
                                "playPause": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "next": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "previous": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "stop": {
                                    "$ref": "#/$defs/hotkeyList"
                                }
                            }
                        },
                        "navigation": {
                            "type": "object",
                            "properties": {
                                "up": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "down": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "left": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "right": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "moveUp": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "moveDown": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "moveLeft": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "moveRight": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "activate": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "close": {
                                    "$ref": "#/$defs/hotkeyList"
                                }
                            }
                        },
                        "layout": {
                            "type": "object",
                            "properties": {
                                "increaseVisibleTiles": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "decreaseVisibleTiles": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "increaseScreens": {
                                    "$ref": "#/$defs/hotkeyList"
                                },
                                "decreaseScreens": {
                                    "$ref": "#/$defs/hotkeyList"
                                }
                            }
                        }
                    }
                }
            },
            "additionalProperties": false
        },
        "gamepad": {
            "type": "object",
            "properties": {
                "repeatDelayMs": {
                    "description": "How long a direction is held before it repeats.",
                    "type": "integer",
                    "minimum": 0
                },
                "repeatIntervalMs": {
                    "description": "The interval between repeats of a held direction.",
                    "type": "integer",
                    "minimum": 0
                },
                "bindings": {
                    "description": "Gamepad chords bound to shell actions. Any keyboard.hotkeys action id is bindable under the same group and name.",
                    "type": "object",
                    "properties": {
                        "navigation": {
                            "type": "object",
                            "properties": {
                                "up": {
                                    "$ref": "#/$defs/gamepadChordList"
                                },
                                "down": {
                                    "$ref": "#/$defs/gamepadChordList"
                                },
                                "left": {
                                    "$ref": "#/$defs/gamepadChordList"
                                },
                                "right": {
                                    "$ref": "#/$defs/gamepadChordList"
                                },
                                "moveUp": {
                                    "$ref": "#/$defs/gamepadChordList"
                                },
                                "moveDown": {
                                    "$ref": "#/$defs/gamepadChordList"
                                },
                                "moveLeft": {
                                    "$ref": "#/$defs/gamepadChordList"
                                },
                                "moveRight": {
                                    "$ref": "#/$defs/gamepadChordList"
                                },
                                "activate": {
                                    "$ref": "#/$defs/gamepadChordList"
                                },
                                "dismiss": {
                                    "$ref": "#/$defs/gamepadChordList"
                                },
                                "close": {
                                    "$ref": "#/$defs/gamepadChordList"
                                },
                                "cycleBackward": {
                                    "$ref": "#/$defs/gamepadChordList"
                                },
                                "cycleForward": {
                                    "$ref": "#/$defs/gamepadChordList"
                                }
                            },
                            "additionalProperties": false
                        },
                        "overview": {
                            "type": "object",
                            "properties": {
                                "toggle": {
                                    "$ref": "#/$defs/gamepadChordList"
                                }
                            },
                            "additionalProperties": false
                        },
                        "system": {
                            "type": "object",
                            "additionalProperties": {
                                "$ref": "#/$defs/gamepadChordList"
                            }
                        },
                        "media": {
                            "type": "object",
                            "additionalProperties": {
                                "$ref": "#/$defs/gamepadChordList"
                            }
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "mouseAndTouchpad": {
            "type": "object",
            "properties": {
                "mouseNaturalScrolling": {
                    "type": "boolean"
                },
                "touchpadNaturalScrolling": {
                    "type": "boolean"
                },
                "wheelScrollFactor": {
                    "type": "number",
                    "minimum": 0
                },
                "mouseAccelerationProfile": {
                    "type": "string",
                    "enum": [
                        "default",
                        "adaptive",
                        "flat"
                    ]
                },
                "touchpadAccelerationProfile": {
                    "type": "string",
                    "enum": [
                        "default",
                        "adaptive",
                        "flat"
                    ]
                },
                "touchpadTapToClick": {
                    "type": "boolean"
                },
                "touchpadDisableWhileTyping": {
                    "type": "boolean"
                },
                "mouseSpeed": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                },
                "touchpadSpeed": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                }
            },
            "additionalProperties": false
        },
        "files": {
            "type": "object",
            "properties": {
                "showHidden": {
                    "type": "boolean"
                },
                "sortBy": {
                    "type": "string",
                    "enum": [
                        "name",
                        "modified",
                        "size",
                        "type"
                    ]
                },
                "sortDescending": {
                    "type": "boolean"
                },
                "foldersFirst": {
                    "type": "boolean"
                },
                "showDetails": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        },
        "theme": {
            "type": "object",
            "properties": {
                "color": {
                    "type": "string"
                },
                "gtkTheme": {
                    "type": "string"
                },
                "iconTheme": {
                    "type": "string"
                },
                "cursorTheme": {
                    "type": "string",
                    "description": "Xcursor theme name; empty keeps the session's XCURSOR_THEME"
                },
                "cursorSize": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Nominal cursor size in logical pixels; 0 keeps the session's XCURSOR_SIZE"
                },
                "focusIndicator": {
                    "type": "string",
                    "enum": [
                        "border",
                        "grayscale",
                        "none"
                    ]
                },
                "workspaceIcon": {
                    "type": "string",
                    "enum": [
                        "hybrid",
                        "category",
                        "application"
                    ],
                    "description": "What the workspace buttons show: hybrid (the application or the category), category, or application"
                },
                "animationSpeed": {
                    "type": "number",
                    "minimum": 0.05,
                    "maximum": 10,
                    "description": "Speed of the shell's animations: 1 as designed, 0.5 at half speed, 2 at double speed"
                },
                "optimizedOverview": {
                    "type": "boolean",
                    "description": "Keep the open overview from repainting the screen behind it: the blurred backdrop is a still image and the monitoring graphs step instead of sliding. Off for a live backdrop and smooth graphs, at a higher GPU cost."
                },
                "antialiasing": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "off",
                        "2x",
                        "4x"
                    ],
                    "description": "Multisampling of the shell's rendering. auto: 4x on a dedicated GPU, 2x on an integrated one, off in software rendering."
                },
                "statusBar": {
                    "type": "string",
                    "enum": [
                        "none",
                        "topPanel",
                        "notch"
                    ]
                },
                "statusBarContent": {
                    "type": "object",
                    "properties": {
                        "showClock": {
                            "type": "boolean"
                        },
                        "clockFormat": {
                            "type": "string",
                            "enum": [
                                "locale",
                                "twelveHour",
                                "twentyFourHour"
                            ]
                        },
                        "showKeyboardLayout": {
                            "type": "boolean"
                        },
                        "showWifi": {
                            "type": "boolean"
                        },
                        "showVolume": {
                            "type": "boolean"
                        },
                        "showBattery": {
                            "type": "boolean"
                        },
                        "showBatteryPercentage": {
                            "type": "boolean"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "idle": {
            "type": "object",
            "properties": {
                "dimTimeoutSeconds": {
                    "type": "integer",
                    "minimum": 0
                },
                "blankTimeoutSeconds": {
                    "type": "integer",
                    "minimum": 0
                },
                "fadeSeconds": {
                    "type": "number",
                    "minimum": 0
                },
                "automaticPowerAction": {
                    "type": "string",
                    "enum": [
                        "disabled",
                        "suspend",
                        "hibernate",
                        "suspendThenHibernate"
                    ]
                },
                "automaticPowerTimeoutSeconds": {
                    "type": "integer",
                    "minimum": 0
                },
                "powerButtonAction": {
                    "type": "string",
                    "enum": [
                        "disabled",
                        "suspend",
                        "hibernate",
                        "suspendThenHibernate",
                        "powerOff"
                    ]
                }
            },
            "additionalProperties": false
        },
        "notifications": {
            "type": "object",
            "properties": {
                "batteryLowThreshold": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                },
                "batteryCriticalThreshold": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                }
            },
            "additionalProperties": false
        }
    }
}
