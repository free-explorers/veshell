{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Veshell Settings",
    "description": "System settings",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string"
        },
        "environment": {
            "type": "object",
            "properties": {
                "variables": {
                    "description": "Environment variables applied to applications launched by Veshell, as a NAME to value map.",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "keyboard": {
            "type": "object",
            "properties": {
                "layout": {
                    "type": "string"
                },
                "swapAltAndWin": {
                    "type": "boolean"
                },
                "repeat": {
                    "type": "boolean"
                },
                "repeatDelayMs": {
                    "type": "integer",
                    "minimum": 0
                },
                "repeatRate": {
                    "type": "integer",
                    "minimum": 0
                },
                "hotkeys": {
                    "type": "object",
                    "properties": {
                        "system": {
                            "type": "object",
                            "properties": {
                                "increaseVolume": {
                                    "type": "string"
                                },
                                "decreaseVolume": {
                                    "type": "string"
                                },
                                "muteVolume": {
                                    "type": "string"
                                },
                                "increaseBrightness": {
                                    "type": "string"
                                },
                                "decreaseBrightness": {
                                    "type": "string"
                                }
                            }
                        },
                        "media": {
                            "type": "object",
                            "properties": {
                                "playPause": {
                                    "type": "string"
                                },
                                "next": {
                                    "type": "string"
                                },
                                "previous": {
                                    "type": "string"
                                },
                                "stop": {
                                    "type": "string"
                                }
                            }
                        },
                        "screen": {
                            "type": "object",
                            "properties": {
                                "focusWorkspaceAbove": {
                                    "type": "string"
                                },
                                "focusWorkspaceBelow": {
                                    "type": "string"
                                },
                                "reorderWorkspaceAbove": {
                                    "type": "string"
                                },
                                "reorderWorkspaceBelow": {
                                    "type": "string"
                                }
                            }
                        },
                        "workspace": {
                            "type": "object",
                            "properties": {
                                "focusLeftTileable": {
                                    "type": "string"
                                },
                                "focusRightTileable": {
                                    "type": "string"
                                },
                                "reorderLeftTileable": {
                                    "type": "string"
                                },
                                "reorderRightTileable": {
                                    "type": "string"
                                },
                                "closeTileable": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            },
            "additionalProperties": false
        },
        "mouseAndTouchpad": {
            "type": "object",
            "properties": {
                "mouseNaturalScrolling": {
                    "type": "boolean"
                },
                "touchpadNaturalScrolling": {
                    "type": "boolean"
                },
                "wheelScrollFactor": {
                    "type": "number",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "theme": {
            "type": "object",
            "properties": {
                "color": {
                    "type": "string"
                },
                "gtkTheme": {
                    "type": "string"
                },
                "iconTheme": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "idle": {
            "type": "object",
            "properties": {
                "dimTimeoutSeconds": {
                    "type": "integer",
                    "minimum": 0
                },
                "blankTimeoutSeconds": {
                    "type": "integer",
                    "minimum": 0
                },
                "fadeSeconds": {
                    "type": "number",
                    "minimum": 0
                },
                "automaticPowerAction": {
                    "type": "string",
                    "enum": [
                        "disabled",
                        "suspend",
                        "hibernate",
                        "suspendThenHibernate"
                    ]
                },
                "automaticPowerTimeoutSeconds": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "notifications": {
            "type": "object",
            "properties": {
                "batteryLowThreshold": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                },
                "batteryCriticalThreshold": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                }
            },
            "additionalProperties": false
        }
    }
}
