{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Hotkeys",
    "description": "A map of actions to the list of key chords bound to them",
    "type": "object",
    "$defs": {
        "hotkeyList": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "properties": {
        "$schema": {
            "type": "string"
        },
        "system": {
            "type": "object",
            "properties": {
                "increaseVolume": {
                    "$ref": "#/$defs/hotkeyList"
                },
                "decreaseVolume": {
                    "$ref": "#/$defs/hotkeyList"
                },
                "muteVolume": {
                    "$ref": "#/$defs/hotkeyList"
                },
                "increaseBrightness": {
                    "$ref": "#/$defs/hotkeyList"
                },
                "decreaseBrightness": {
                    "$ref": "#/$defs/hotkeyList"
                },
                "toggleKeyboardLayout": {
                    "$ref": "#/$defs/hotkeyList"
                }
            }
        },
        "media": {
            "type": "object",
            "properties": {
                "playPause": {
                    "$ref": "#/$defs/hotkeyList"
                },
                "next": {
                    "$ref": "#/$defs/hotkeyList"
                },
                "previous": {
                    "$ref": "#/$defs/hotkeyList"
                },
                "stop": {
                    "$ref": "#/$defs/hotkeyList"
                }
            }
        },
        "navigation": {
            "type": "object",
            "properties": {
                "up": {
                    "$ref": "#/$defs/hotkeyList"
                },
                "down": {
                    "$ref": "#/$defs/hotkeyList"
                },
                "left": {
                    "$ref": "#/$defs/hotkeyList"
                },
                "right": {
                    "$ref": "#/$defs/hotkeyList"
                },
                "moveUp": {
                    "$ref": "#/$defs/hotkeyList"
                },
                "moveDown": {
                    "$ref": "#/$defs/hotkeyList"
                },
                "moveLeft": {
                    "$ref": "#/$defs/hotkeyList"
                },
                "moveRight": {
                    "$ref": "#/$defs/hotkeyList"
                },
                "activate": {
                    "$ref": "#/$defs/hotkeyList"
                },
                "close": {
                    "$ref": "#/$defs/hotkeyList"
                }
            }
        }
    },
    "additionalProperties": false
}
